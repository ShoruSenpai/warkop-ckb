{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "warkop_try (Supabase)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "toolArgs": [
        "--dart-define=SUPABASE_URL=${input:supabaseUrl}",
        "--dart-define=SUPABASE_PUBLISHABLE_KEY=${input:supabasePublishableKey}"
      ]
    }
  ],
  "inputs": [
    {
      "id": "supabaseUrl",
      "type": "promptString",
      "description": "Supabase Project URL (https://<project-ref>.supabase.co)",
      "default": "https://bhafnanmoguwmrbtwrmv.supabase.co"
    },
    {
      "id": "supabasePublishableKey",
      "type": "promptString",
      "description": "Supabase publishable key (sb_publishable_...)",
      "password": true
    }
  ]
}